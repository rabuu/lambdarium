use crate::meta::*;
use crate::parser::lexer::{LexerError, Token};
use crate::NonEmpty;

grammar();

extern {
	type Location = usize;
	type Error = LexerError;

	enum Token {
	    "(" => Token::ParenOpen,
	    ")" => Token::ParenClose,
	    "lambda" => Token::Lambda,
	    "." => Token::Dot,
	    "variable" => Token::Variable(<String>),
		"def" => Token::Def,
		"metavariable" => Token::MetaVariable(<String>),
		"=" => Token::Equals,
		";" => Token::Semicolon,
	    "[" => Token::BracketOpen,
	    "]" => Token::BracketClose,
	    "->" => Token::Arrow,
	}
}

pub Term: Term = {
	Abstraction => Term::Abs(<>),
	AppTerm,
};

AppTerm: Term = {
	PostfixTerm,
	Application => Term::App(<>),
};

PostfixTerm: Term = {
	SimpleTerm,
	Substitution => Term::Subst(<>),
};

SimpleTerm: Term = {
	Variable => Term::Var(<>),
	MetaVariable => Term::MetaVar(<>),
	"(" <Term> ")",
};

MetaVariable: MetaVariable = "metavariable" => MetaVariable::from(<>);

Variable: Variable = "variable" => Variable::from(<>);

Application: Application = <lhs: AppTerm> <rhs: PostfixTerm> => Application {
	lhs: Box::new(lhs),
	rhs: Box::new(rhs)
};

Abstraction: Abstraction = "lambda" <binders: Variable+> "." <body: Term> => Abstraction {
	binders: NonEmpty::from_vec(binders).expect("at least one binder by grammar"),
	body: Box::new(body),
};

Substitution: Substitution = <body: PostfixTerm> "[" <var: Variable> "->" <replacement: Term> "]" => Substitution {
	body: Box::new(body),
	var,
	replacement: Box::new(replacement),
};

pub Definition: Definition = "def" <metavar: MetaVariable> "=" <body: Term> => Definition { metavar, body };

pub Item: Item = {
	Definition => Item::Def(<>),
	Term => Item::Term(<>),
};

pub Program: Program = <items: (<Item> ";")*> <last: Item?> => {
	let mut definitions = Vec::new();
	let mut terms = Vec::new();

	for item in items.into_iter().chain([last].into_iter().flatten()) {
		match item {
			Item::Def(def) => definitions.push(def),
			Item::Term(term) => terms.push(term),
		}
	}

	Program { definitions, terms }
};
