use std::collections::VecDeque;

use crate::ast;
use crate::parser::lexer::{LexerError, Token};

grammar<'src>();

extern {
	type Location = usize;
	type Error = LexerError;

	enum Token<'src> {
	    "(" => Token::ParenOpen,
	    ")" => Token::ParenClose,
	    "lambda" => Token::Lambda,
	    "." => Token::Dot,
	    "variable" => Token::Variable(<&'src str>),
	}
}

pub Term: ast::Term<'src> = {
	Abs => ast::Term::Abs(<>),
	AppTerm,
};

AppTerm: ast::Term<'src> = {
	SimpleTerm,
	App => ast::Term::App(<>),
};

SimpleTerm: ast::Term<'src> = {
	Var => ast::Term::Var(<>),
	"(" <Term> ")",
};

App: ast::Application<'src> = <first: AppTerm> <second: SimpleTerm> => ast::Application { first: Box::new(first), second: Box::new(second) };

Var: ast::Variable<'src> = "variable" => ast::Variable { inner: <> };

Abs: ast::Abstraction<'src> = "lambda" <binders: Var+> "." <body: Term> => ast::Abstraction::from_uncurried(VecDeque::from(binders), body);
