use std::collections::VecDeque;

use crate::{Term, Variable, Abstraction, Application};
use crate::parser::lexer::{LexerError, Token};

grammar();

extern {
	type Location = usize;
	type Error = LexerError;

	enum Token {
	    "(" => Token::ParenOpen,
	    ")" => Token::ParenClose,
	    "lambda" => Token::Lambda,
	    "." => Token::Dot,
	    "variable" => Token::Variable(<String>),
	}
}

pub Term: Term = {
	Abs => Term::Abs(<>),
	AppTerm,
};

AppTerm: Term = {
	SimpleTerm,
	App => Term::App(<>),
};

SimpleTerm: Term = {
	Var => Term::Var(<>),
	"(" <Term> ")",
};

App: Application = <first: AppTerm> <second: SimpleTerm> => Application { first: Box::new(first), second: Box::new(second) };

Var: Variable = "variable" => Variable { inner: <> };

Abs: Abstraction = "lambda" <binders: Var+> "." <body: Term> => Abstraction::from_uncurried(VecDeque::from(binders), body);
