use crate::meta::{Program, Definition, Term};
use crate::parser::ProgramElement;
use crate::parser::lexer::{LexerError, Token};

grammar();

extern {
	type Location = usize;
	type Error = LexerError;

	enum Token {
	    "(" => Token::ParenOpen,
	    ")" => Token::ParenClose,
	    "lambda" => Token::Lambda,
	    "." => Token::Dot,
	    "variable" => Token::Variable(<String>),
		"def" => Token::Def,
		"metavariable" => Token::MetaVariable(<String>),
		"=" => Token::Equals,
		";" => Token::Semicolon,
	}
}

pub Term: Term = {
	Abs,
	AppTerm,
};

AppTerm: Term = {
	SimpleTerm,
	Application,
};

SimpleTerm: Term = {
	"variable" => Term::Var(<>),
	"metavariable" => Term::Meta(<>),
	"(" <Term> ")",
};

Application: Term = <lhs: AppTerm> <rhs: SimpleTerm> => Term::App {
	lhs: Box::new(lhs),
	rhs: Box::new(rhs)
};

Abs: Term = "lambda" <binders: "variable"+> "." <body: Term> => Term::Abs {
	binders,
	body: Box::new(body),
};

pub Program: Program = <elements: (<ProgramElement> ";")*> <last: ProgramElement?> => {
	let mut defs = Vec::new();
	let mut terms = Vec::new();
	for element in elements.into_iter().map(Some).chain(std::iter::once(last)).flatten() {
		match element {
			ProgramElement::Def(d) => defs.push(d),
			ProgramElement::Term(t) => terms.push(t),
		}
	}

	Program { defs, terms }
};

ProgramElement: ProgramElement = {
	Def => ProgramElement::Def(<>),
	Term => ProgramElement::Term(<>),
};

Def: Definition = "def" <metavar: "metavariable"> "=" <body: Term> => Definition { metavar, body };
