use crate::ast;
use crate::parser::lexer::{Lexer, LexerError, Token};

grammar<'src>();

extern {
	type Location = usize;
	type Error = LexerError;

	enum Token<'src> {
	    "(" => Token::ParenOpen,
	    ")" => Token::ParenClose,
	    "\\" => Token::Lambda,
	    "." => Token::Dot,
	    "variable" => Token::Variable(<&'src str>),
	}
}

Variable: ast::Variable<'src> = "variable" => ast::Variable { inner: <> };

pub Var: ast::Term<'src> = {
	Variable => ast::Term::Var(<>),
};
