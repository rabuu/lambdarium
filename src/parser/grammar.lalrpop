use std::collections::VecDeque;

use crate::core::{Term, Variable, Abstraction, Application};
use crate::meta::{Program, Definition, MetaVariable};
use crate::parser::ProgramElement;
use crate::parser::lexer::{LexerError, Token};

grammar();

extern {
	type Location = usize;
	type Error = LexerError;

	enum Token {
	    "(" => Token::ParenOpen,
	    ")" => Token::ParenClose,
	    "lambda" => Token::Lambda,
	    "." => Token::Dot,
	    "variable" => Token::Variable(<String>),
		"def" => Token::Def,
		"metavariable" => Token::MetaVariable(<String>),
		"=" => Token::Equals,
		";" => Token::Semicolon,
	}
}

//
// Core λ-calculus
//

pub Term: Term = {
	Abs => Term::Abs(<>),
	AppTerm,
};

AppTerm: Term = {
	SimpleTerm,
	App => Term::App(<>),
};

SimpleTerm: Term = {
	Var => Term::Var(<>),
	"(" <Term> ")",
};

App: Application = <lhs: AppTerm> <rhs: SimpleTerm> => Application { lhs: Box::new(lhs), rhs: Box::new(rhs) };

Var: Variable = "variable" => Variable { inner: <> };

Abs: Abstraction = "lambda" <binders: Var+> "." <body: Term> => Abstraction::from_uncurried(VecDeque::from(binders), body);

//
// Meta-language
//

pub Program: Program = <elements: (<ProgramElement> ";")*> <last: ProgramElement?> => {
	let mut lets = Vec::new();
	let mut terms = Vec::new();
	for element in elements.into_iter().map(Some).chain(std::iter::once(last)).flatten() {
		match element {
			ProgramElement::Def(l) => lets.push(l),
			ProgramElement::Term(t) => terms.push(t),
		}
	}

	Program { lets, terms }
};

ProgramElement: ProgramElement = {
	Def => ProgramElement::Def(<>),
	Term => ProgramElement::Term(<>),
};

MetaVar: MetaVariable = "metavariable" => MetaVariable { inner: <> };

Def: Definition = "def" <metavar: MetaVar> "=" <body: Term> => Def { metavar, body };
